[
  {
    "name": "no-op keywords are dropped, properties: {} kept",
    "tool": {"name": "t", "schema": {
      "type": "object", "description": "", "properties": {}, "required": [], "additionalProperties": true, "$defs": {}
    }},
    "expected_schema": {"type": "object", "properties": {}}
  },
  {
    "name": "single-element type arrays and empty items",
    "tool": {"name": "t", "schema": {"type": "object", "properties": {"tags": {"type": ["array"], "items": {}}, "x": {"type": "array", "items": true, "additionalItems": true}}}},
    "expected_schema": {"type": "object", "properties": {"tags": {"type": "array"}, "x": {"type": "array"}}}
  },
  {
    "name": "strict tools keep required and additionalProperties",
    "strict": true,
    "tool": {"name": "t", "schema": {"type": "object", "properties": {}, "required": [], "additionalProperties": false, "description": ""}},
    "expected_schema": {"type": "object", "properties": {}, "required": [], "additionalProperties": false}
  },
  {
    "name": "additionalProperties: true beside unevaluatedProperties: false is kept",
    "tool": {"name": "t", "schema": {"type": "object", "additionalProperties": true, "unevaluatedProperties": false}}
  },
  {
    "name": "items: {} beside unevaluatedItems: false is kept",
    "tool": {"name": "t", "schema": {"type": "array", "items": {}, "unevaluatedItems": false}}
  },
  {
    "name": "keywords in a branch stay when the parent restricts unevaluated properties",
    "tool": {"name": "t", "schema": {"allOf": [{"additionalProperties": true}], "unevaluatedProperties": false}}
  },
  {
    "name": "keywords stay when unevaluatedProperties is a schema",
    "tool": {"name": "t", "schema": {"additionalProperties": true, "unevaluatedProperties": {"type": "string"}}}
  },
  {
    "name": "permissive unevaluated keywords are still dropped",
    "tool": {"name": "t", "schema": {"type": "object", "additionalProperties": true, "unevaluatedProperties": true}},
    "expected_schema": {"type": "object"}
  },
  {
    "name": "meaningful values are kept",
    "tool": {"name": "t", "schema": {"type": "object", "properties": {"a": {"type": ["string", "null"], "items": {"type": "string"}}}, "required": ["a"], "additionalProperties": false}}
  }
]
